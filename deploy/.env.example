# ModaHouse serwer sazlamalary. Şu faýly .env adyna göçürip dolduryň: cp .env.example .env

# Domen (DNS-de A ýazgysy serweriň IP-sine görkezmeli). Domen ýok bolsa :80 goýuň.
DOMAIN=modahouse.tm

# Maglumatlar binýadynyň paroly we JWT açary: uzyn tötänleýin setirler.
# Döretmek üçin: openssl rand -hex 32
POSTGRES_PASSWORD=
JWT_SECRET=

# Ilkinji administrator. Serwer açylanda bu ulanyjy admin bolýar (ýok bolsa döredilýär).
# Parol azyndan 8 simwol. Soňra admin paneli: https://DOMAIN/admin
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Programmalar üçin başlangyç salgylar (soňra admin panelinden üýtgedip bolýar).
PUBLIC_API_URL=https://modahouse.tm
PUBLIC_WEB_URL=https://modahouse.tm

# true: ilkinji açylyşda synag postlary goşulýar (174 post, dükanlar, reels).
# Synag hasaplarynyň paroly umumy (modahouse123), hakyky işe başlanyňyzda false goýuň.
SEED=true

# AI kömekçisi (Claude) üçin açar. Boş bolsa, AI taýýar nusgalar bilen işleýär.
ANTHROPIC_API_KEY=

# Ýükleme çäkleri (MB).
MAX_UPLOAD_MB=20
MAX_VIDEO_MB=60
