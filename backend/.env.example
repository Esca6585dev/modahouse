PORT=8080
# postgres (önümçilik) ýa-da sqlite (ýerli synag)
DB_DRIVER=postgres
DATABASE_URL=postgres://moda:moda@localhost:5432/modahouse?sslmode=disable
# Hökman üýtgediň: uzyn tötänleýin setir
JWT_SECRET=change-me
UPLOAD_DIR=uploads
# Birnäçe çeşme üçin otur bilen bölüň, mysal: http://localhost:3000,https://modahouse.tm
CORS_ORIGINS=*
# Boş bazany demo maglumatlar bilen doldurmak
SEED=true
MAX_UPLOAD_MB=20
TOKEN_TTL_DAYS=30
TRUSTED_PROXIES=127.0.0.1,::1
